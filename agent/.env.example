# 复制为 agent/.env 后填写。agent/.env 不入库。

# DeepSeek-V4.1-Flash，模型名用 deepseek-flash
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=

# 千问 text-embedding-v4，维度必须与 Milvus 一致
EMBEDDING_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=

# 千问 qwen3.7-text-rerank，文本排序接口，不是对话接口
RERANK_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=

MILVUS_URI=http://127.0.0.1:19530

RECALL_LIMIT=20
RERANK_TOP_N=5
